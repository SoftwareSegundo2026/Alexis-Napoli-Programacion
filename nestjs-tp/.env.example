# Puerto en el que escucha la aplicación (src/main.ts lo lee con ConfigService).
PORT=3300

# OBLIGATORIO: secreto con el que se firman las credenciales (mínimo 32 caracteres).
# Sin él la aplicación no arranca. Generá uno al azar, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Minutos de vida de una credencial (por defecto 30).
JWT_EXPIRES_MINUTES=30

# Costo del hash de contraseñas, de 4 a 15 (por defecto 12, como los hash existentes).
PASSWORD_HASH_ROUNDS=12

# Nivel mínimo de log (por defecto log): fatal, error, warn, log, debug o verbose.
# Los logs salen como una línea JSON por evento. Un valor desconocido impide arrancar.
LOG_LEVEL=log

# Solo con Docker (docker-compose.yml): puerto del HOST donde queda la API (por
# defecto 3300). Dentro del contenedor, el compose fija PORT=3000 y
# DATABASE_PATH=/var/lib/chinook/chinook.db (el volumen): esos dos de acá no se usan.
# API_PORT=3300

# Base de trabajo. Si no existe, se crea copiando data/chinook.template.db.
DATABASE_PATH=data/chinook.db

# NestJS Observe (https://observe.nestjs.com) - opcional.
# Copiá este archivo como .env y completá las claves desde el dashboard.
# Mientras estén vacías, la telemetría queda desactivada.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
