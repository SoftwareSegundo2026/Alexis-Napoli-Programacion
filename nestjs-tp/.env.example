# Puerto en el que escucha la aplicación (src/main.ts lo lee con ConfigService).
PORT=3300

# OBLIGATORIA: clave que exigen POST/PATCH/DELETE en el header X-API-Key.
# Sin ella la aplicación no arranca. Usá un valor largo y no lo subas al repo.
WRITE_API_KEY=

# Base de trabajo. Si no existe, se crea copiando data/chinook.template.db.
DATABASE_PATH=data/chinook.db

# NestJS Observe (https://observe.nestjs.com) - opcional.
# Copiá este archivo como .env y completá las claves desde el dashboard.
# Mientras estén vacías, la telemetría queda desactivada.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
